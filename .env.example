# prototype_net — environment configuration
# Copy to .env and fill in every required value before running any make targets.
#
#   cp .env.example .env
#
# The Makefile loads this file automatically (-include .env; export), so all
# variables here are available to every target without manual exporting.

# ===========================================================================
# Docker Compose  (Postgres + test client)
# ===========================================================================

# Postgres password. Pick any value — just keep it consistent.
POSTGRES_PASSWORD=

# IPv4 address of the server VM.
# Leave blank initially. After `make vm-up` prints the IP, fill it in here.
SERVER_VM_IP=

# ===========================================================================
# Terraform  (TF_VAR_* are read automatically by terraform)
# ===========================================================================

# Bridge interface on the hypervisor host that the VM NIC will attach to.
# REQUIRED. Find it with: ip link show type bridge
# Example: TF_VAR_vm_bridge_name=br0
TF_VAR_vm_bridge_name=

# Libvirt network name — only used when TF_VAR_vm_bridge_name is empty
# (falls back to libvirt NAT). Leave as "default" unless you have a custom
# libvirt network.
TF_VAR_vm_network_name=default

# Libvirt URI used by Terraform.
# - Local libvirt daemon: qemu:///system
# - Remote libvirt over OpenSSH (respects ~/.ssh/config):
#   qemu+sshcmd://<host-alias-or-host>/system
# - Remote libvirt over provider SSH transport:
#   qemu+ssh://<user>@<host>/system
TF_VAR_libvirt_uri=qemu:///system

# SSH public key to inject into the VM's ubuntu user.
# REQUIRED. Must be the full key string, not a file path.
#
# WARNING: do NOT copy from ~/.ssh/id_ed25519.pub — your active key may
# differ (e.g. loaded from a hardware token or keychain).
# Always get it from the SSH agent:
#
#   ssh-add -L
#
# Copy the entire output line (ssh-ed25519 AAAA... user@host) below.
TF_VAR_ssh_public_key=

# ===========================================================================
# Ansible  (passed to `make vm-provision` as -e flags)
# These use the TF_VAR_ prefix so they load from .env without extra work.
# ===========================================================================

# IPv4 address of the hypervisor host, reachable from inside the VM.
# REQUIRED. This is the IP of the bridge interface on the hypervisor.
# Find it with: ip addr show <bridge>   (e.g. ip addr show br0)
# Example: TF_VAR_host_bridge_ip=192.168.100.51
TF_VAR_host_bridge_ip=

# Postgres password — must match POSTGRES_PASSWORD above.
# WARNING: copy the literal value here. Do NOT use $POSTGRES_PASSWORD —
# .env is not a shell script; variable references are not expanded by Make.
TF_VAR_postgres_password=

# Public IPv6 address of the server VM, used by the eBPF daemon as the
# NAT source address for forwarded packets.
# Leave blank initially. After `make vm-up`, find it with:
#   ssh ubuntu@<SERVER_VM_IP> ip -6 addr show scope global
TF_VAR_server_ipv6=

# IP address the DNS server binds to inside the VM.
# 0.0.0.0 means all interfaces — correct for most setups.
TF_VAR_dns_listen_addr=0.0.0.0

# ===========================================================================
# Server VM services  (used at runtime by daemon + dns-server)
# Set these after the IPSec tunnel is up for the first time.
# ===========================================================================

# Network interface the eBPF TC programs attach to (the IPSec tunnel interface).
# Find it after tunnel is up: ip link show   (usually xfrm0 or ipsec0)
INTERFACE_NAME=
