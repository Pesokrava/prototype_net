# Copy this file to .env and fill in the values
# cp .env.example .env

# ------------------------------------------------------------
# Docker Compose (Postgres + test client)
# ------------------------------------------------------------

# Postgres password
POSTGRES_PASSWORD=

# IP address of the server VM (used by test client to connect + configure DNS)
SERVER_VM_IP=

# ------------------------------------------------------------
# Terraform (all exposed as TF_VAR_* equivalents)
# Run: export $(grep -v '^#' .env | xargs) before terraform apply
# Or set TF_VAR_* directly in your shell
# ------------------------------------------------------------

# libvirt bridge IP — verify with: ip addr show virbr0
# Default libvirt NAT network is usually 192.168.122.1
TF_VAR_host_bridge_ip=192.168.122.1

# Postgres password (must match POSTGRES_PASSWORD above)
TF_VAR_postgres_password=

# Static IPv6 address to assign to the server VM
TF_VAR_server_ipv6=

# IP address the DNS server binds to inside the VM (usually 0.0.0.0)
TF_VAR_dns_listen_addr=0.0.0.0

# ------------------------------------------------------------
# Server VM services (daemon + dns-server)
# These are injected via cloud-init into systemd units
# ------------------------------------------------------------

# Network interface the eBPF TC programs attach to (IPSec tunnel interface)
# Check with: ip link show after tunnel is up (usually xfrm0 or ipsec0)
INTERFACE_NAME=

# Server VM public IPv6 address (used as NAT src for forwarded packets)
SERVER_IPV6=

# VPN-assigned IPv6 address of the IKEv2/IPSec client (traffic selector)
# Check with: swanctl --list-sas (look for the virtual IP assigned to the client)
CLIENT_IPV6=fd00:abcd:0000:0001::2
