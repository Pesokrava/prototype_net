[Unit]
Description=Load strongSwan swanctl connections after charon starts
After=strongswan-starter.service
BindsTo=strongswan-starter.service
# Re-run whenever strongswan-starter restarts so connections are always loaded
PartOf=strongswan-starter.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Retry until the VICI socket is ready (charon may not expose it immediately)
ExecStartPre=/bin/sh -c 'for i in $(seq 1 20); do test -S /var/run/charon.vici && break; sleep 1; done'
ExecStart=/usr/sbin/swanctl --load-all
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
