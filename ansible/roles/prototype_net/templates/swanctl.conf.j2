pools {
    client_pool {
        addrs = {{ vip_pool_start }}-{{ vip_pool_end }}
        dns = {{ host_bridge_ip }}
    }
}
connections {
    prototype {
        version = 2
        proposals = aes256-sha256-ecp384
        rekey_time = 4h
        pools = client_pool
        local {
            auth = pubkey
            certs = server.crt
            id = %any
        }
        remote {
            auth = pubkey
            cacerts = ca.crt
            id = %any
        }
        children {
            prototype {
                esp_proposals = aes256gcm128
                local_ts = {{ synthetic_prefix_cidr }}
                remote_ts = {{ synthetic_prefix_cidr }}
                mode = tunnel
                if_id_in = {{ xfrm_if_id }}
                if_id_out = {{ xfrm_if_id }}
                start_action = none
                dpd_action = clear
            }
        }
    }
}
